---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string; // root-relative OG image (1200x630)
  tone?: 'marigold' | 'paper'; // tone of the first section, which the header sits on
}
const { title, description = site.description, image = '/og.png', tone = 'paper' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome, Edge, Brave, Arc, Firefox',
  softwareVersion: site.version,
  url: site.url,
  downloadUrl: site.zip,
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [site.repo],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={tone === 'marigold' ? '#f2a516' : '#fff6e3'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Before first paint: which keys and which extensions page to show (see Shortcut.astro, ExtPage.astro).
      (function () {
        var d = document.documentElement, ua = navigator.userAgent;
        var p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        var touchMac = /mac/i.test(p) && navigator.maxTouchPoints > 1;
        d.classList.add('js');
        d.dataset.os = /android|iphone|ipad|ipod/i.test(ua) || touchMac ? 'mobile' : /mac/i.test(p) ? 'mac' : /win|linux|cros|x11/i.test(p + ' ' + ua) ? 'pc' : 'other';
        d.dataset.browser = navigator.brave ? 'brave' : /Edg\//.test(ua) ? 'edge' : /OPR\//.test(ua) ? 'opera' : /Vivaldi/.test(ua) ? 'vivaldi' : /Firefox\//.test(ua) ? 'firefox' : /Chrome\//.test(ua) ? 'chrome' : /Safari\//.test(ua) ? 'safari' : 'other';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header tone={tone} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
